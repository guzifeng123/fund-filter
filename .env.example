# API
APP_ENVIRONMENT=development
# Local development uses the repository SQLite store. Production may override
# this with a PostgreSQL URL explicitly.
DATABASE_URL=sqlite:///./output/dev/fund.db
DATABASE_CONNECT_TIMEOUT_SECONDS=2
DATA_STATUS_TIMEOUT_SECONDS=2.5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# LLM gateway and sanitized provider observability
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_MAX_RESPONSE_BYTES=65536
LLM_MAX_OUTPUT_CHARS=1000
LLM_AUDIT_ENABLED=true
LLM_OBSERVABILITY_WINDOW_MINUTES=60
LLM_OBSERVABILITY_MINIMUM_REQUESTS=5
LLM_OBSERVABILITY_QUEUE_CAPACITY=256
LLM_OBSERVABILITY_SHUTDOWN_TIMEOUT_SECONDS=2
LLM_OBSERVABILITY_RETENTION_DAYS=30
LLM_ERROR_RATE_ALERT_THRESHOLD=0.2
LLM_TIMEOUT_RATE_ALERT_THRESHOLD=0.1
LLM_ALERT_WEBHOOK_URL=
LLM_ALERT_COOLDOWN_MINUTES=60
LLM_ALERT_TIMEOUT_SECONDS=2

# Data source, reserved for v0.6
# FUND_DATA_SOURCE supports sample_local, csv_local, public_http_json,
# eastmoney_direct. AKShare is validated with scripts/verify_akshare.py; its
# upstream data is intentionally kept outside the transactional snapshot adapter
# except as an opt-in best-effort fund discovery helper for eastmoney_direct.
FUND_DATA_SOURCE=sample_local
FUND_CSV_DIR=data/funds
FUND_DATA_STALE_DAYS=7
# --- eastmoney_direct online adapter (only used when FUND_DATA_SOURCE=eastmoney_direct)
# Explicit comma-separated six-digit codes. The adapter never silently scrapes the
# whole market: with no codes and discovery disabled it fails fast at startup.
FUND_EASTMONEY_FUND_CODES=
FUND_EASTMONEY_TIMEOUT_SECONDS=15
# Minimum gap between upstream requests; keep >=0.5s for low-frequency local use.
FUND_EASTMONEY_MIN_INTERVAL_SECONDS=0.5
# Local on-disk history used to merge incremental NAV pages; empty disables incremental.
FUND_EASTMONEY_CACHE_DIR=
FUND_EASTMONEY_ENABLE_INCREMENTAL=true
# 0 disables AKShare-based discovery; >0 caps the number of discovered candidates.
FUND_EASTMONEY_DISCOVERY_LIMIT=0
# Whether GET /api/data/sources/health probes the upstream.
FUND_EASTMONEY_ENABLE_HEALTH_CHECK=true
# Positive values outside these inclusive ranges are warnings by default.
FUND_NAV_VALUE_MIN=0.01
FUND_NAV_VALUE_MAX=100
FUND_ACCUMULATED_NAV_VALUE_MIN=0.01
FUND_ACCUMULATED_NAV_VALUE_MAX=1000
# true rejects the complete NAV sync transaction when any threshold warning occurs.
FUND_NAV_REJECT_ANOMALIES=false
# Snapshot-level promotion guardrails. 0 disables ratio/date checks; overrides can
# be keyed by adapter source name (for example public_http_json) or persisted
# fund source (for example eastmoney_snapshot).
FUND_SNAPSHOT_MIN_FUND_COUNT=1
FUND_SNAPSHOT_MIN_NAV_COVERAGE_RATIO=0
FUND_SNAPSHOT_MAX_LATEST_NAV_AGE_DAYS=0
FUND_SNAPSHOT_MAX_FUND_COUNT_DROP_RATIO=1
FUND_SNAPSHOT_QUALITY_OVERRIDES=
# Per-fund NAV series structural checks (B2). 0 disables the calendar-day gap /
# stale warning; single-day jump and accumulated-NAV drift are warnings. Duplicate
# / out-of-order NAV dates always reject the candidate generation. Overrides are
# keyed by adapter source name (for example public_http_json) or persisted fund
# source (for example eastmoney_snapshot).
FUND_NAV_SERIES_MAX_GAP_DAYS=0
FUND_NAV_SERIES_MAX_SINGLE_DAY_CHANGE=0.5
FUND_NAV_SERIES_ACCUMULATED_DECREASE_TOLERANCE=0.001
FUND_NAV_SERIES_REJECT_ERRORS=true
FUND_NAV_SERIES_QUALITY_OVERRIDES=
# Static profile field sanity ranges (fees are percentage points). 0 disables the
# "claims 3y/5y return but NAV history too short" check.
FUND_PROFILE_MANAGEMENT_FEE_MAX=3.0
FUND_PROFILE_CUSTODY_FEE_MAX=1.0
FUND_PROFILE_MIN_HISTORY_YEARS_FOR_3Y=0
FUND_PROFILE_MIN_HISTORY_YEARS_FOR_5Y=0
FUND_PROFILE_REJECT_ERRORS=false
FUND_PROFILE_QUALITY_OVERRIDES=
FUND_SYNC_SCHEDULER_ENABLED=true
FUND_SYNC_SCHEDULE_MODE=interval
FUND_SYNC_INTERVAL_MINUTES=5
FUND_SYNC_CRON=15 2 * * *
FUND_SYNC_JITTER_SECONDS=120
FUND_SYNC_MISFIRE_GRACE_SECONDS=900
FUND_SYNC_LOCK_TIMEOUT_MINUTES=120
YINGMI_MCP_ENDPOINT=
PUBLIC_FUND_DATA_BASE_URL=
PUBLIC_FUND_DATA_PROFILE=generic_aliases_v1
PUBLIC_FUND_DATA_TIMEOUT_SECONDS=10
PUBLIC_FUND_DATA_CACHE_DIR=
PUBLIC_FUND_DATA_MIN_INTERVAL_SECONDS=0
PUBLIC_FUND_DATA_BATCH_SIZE=100
PUBLIC_FUND_DATA_MAX_PAGES=100
# Optional comma-separated, operator-managed HTTP(S) proxies. Requests rotate
# round-robin; the app never discovers or fetches public proxy lists.
PUBLIC_FUND_DATA_PROXY_URLS=

# B3 conservative write enhancement. Batch staging writes are semantically
# identical to the per-point path; set FUND_WRITE_BATCH_ENABLED=false to roll
# back to the historical per-flush-per-fund behaviour.
FUND_WRITE_BATCH_ENABLED=true
FUND_WRITE_BATCH_SIZE=100
# Old active generations are exported (funds/navs/metrics) with a SHA-256
# manifest before they are mutated by the next promotion. Archiving failures
# only warn and never block promotion. FUND_ARCHIVE_KEEP_GENERATIONS=0 keeps
# every archive; the separate scripts/cleanup_fund_archives.py enforces
# retention explicitly (dry-run by default).
FUND_ARCHIVE_ENABLED=true
FUND_ARCHIVE_DIR=output/archives
FUND_ARCHIVE_KEEP_GENERATIONS=0

# --- C1: multi-source cross-check reconciliation engine -------------------
# Pure-function gate between C2 (danjuan / sina clients) and C3 (write gate).
# Offline mirrors (sample_local / csv_local / public_http_json) are not forced:
# apply_to_sources defaults to eastmoney_direct only. sina is always attempted
# for the latest accumulated-NAV point even when it is not a required source.
FUND_RECONCILE_ENABLED=true
# Comma-separated sources whose reachability is mandatory; danjuan is the
# primary cross-check source.
FUND_RECONCILE_REQUIRED_SOURCES=danjuan
# strict=true is fail-closed (mismatch blocks the write); strict=false degrades
# contradictions to unverified + warning while still writing.
FUND_RECONCILE_STRICT=true
# Unit-NAV agreement: |a-b| <= abs OR <= rel*max(|a|,|b|). Boundary counts.
FUND_RECONCILE_NAV_ABS_TOLERANCE=0.0005
FUND_RECONCILE_NAV_REL_TOLERANCE=0.002
# Accumulated NAV only compared when both sources disclose it.
FUND_RECONCILE_ACC_NAV_ABS_TOLERANCE=0.005
# Daily change compared in percentage points (abs tolerance only).
FUND_RECONCILE_DAILY_PCT_TOLERANCE=0.3
# Required shared-date coverage vs primary series; below this -> mismatch.
FUND_RECONCILE_MIN_NAV_COVERAGE=0.99
# Major profile disagreements block by default; scale/rate drift warns only.
FUND_RECONCILE_PROFILE_MAJOR_BLOCKS=true
FUND_RECONCILE_SCALE_BLOCKS=false
FUND_RECONCILE_RATES_BLOCKS=false
# Sources the gate runs against; offline mirrors are excluded by default.
FUND_RECONCILE_APPLY_TO_SOURCES=eastmoney_direct
# C2 pacing / network budget for the secondary (danjuan/sina) pull.
FUND_RECONCILE_SECONDARY_TIMEOUT_SECONDS=15
FUND_RECONCILE_SECONDARY_MIN_INTERVAL_SECONDS=0.5
FUND_RECONCILE_SINA_BATCH=true
# Where C3 writes reconciliation reports (default <repo>/output/reconciliation).
FUND_RECONCILE_REPORT_DIR=output/reconciliation
