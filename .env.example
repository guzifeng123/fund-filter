# API
APP_ENVIRONMENT=development
# Local development uses the repository SQLite store. Production may override
# this with a PostgreSQL URL explicitly.
DATABASE_URL=sqlite:///./output/dev/fund.db
DATABASE_CONNECT_TIMEOUT_SECONDS=2
DATA_STATUS_TIMEOUT_SECONDS=2.5
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
WEB_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_BASE=http://localhost:8000/api

# LLM gateway and sanitized provider observability
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_MAX_RESPONSE_BYTES=65536
LLM_MAX_OUTPUT_CHARS=1000
LLM_AUDIT_ENABLED=true
LLM_OBSERVABILITY_WINDOW_MINUTES=60
LLM_OBSERVABILITY_MINIMUM_REQUESTS=5
LLM_OBSERVABILITY_QUEUE_CAPACITY=256
LLM_OBSERVABILITY_SHUTDOWN_TIMEOUT_SECONDS=2
LLM_OBSERVABILITY_RETENTION_DAYS=30
LLM_ERROR_RATE_ALERT_THRESHOLD=0.2
LLM_TIMEOUT_RATE_ALERT_THRESHOLD=0.1
LLM_ALERT_WEBHOOK_URL=
LLM_ALERT_COOLDOWN_MINUTES=60
LLM_ALERT_TIMEOUT_SECONDS=2

# Data source, reserved for v0.6
# FUND_DATA_SOURCE supports sample_local, csv_local, public_http_json.
# AKShare is validated with scripts/verify_akshare.py; its upstream data is
# intentionally kept outside the transactional snapshot adapter.
FUND_DATA_SOURCE=sample_local
FUND_CSV_DIR=data/funds
FUND_DATA_STALE_DAYS=7
# Positive values outside these inclusive ranges are warnings by default.
FUND_NAV_VALUE_MIN=0.01
FUND_NAV_VALUE_MAX=100
FUND_ACCUMULATED_NAV_VALUE_MIN=0.01
FUND_ACCUMULATED_NAV_VALUE_MAX=1000
# true rejects the complete NAV sync transaction when any threshold warning occurs.
FUND_NAV_REJECT_ANOMALIES=false
# Snapshot-level promotion guardrails. 0 disables ratio/date checks; overrides can
# be keyed by adapter source name (for example public_http_json) or persisted
# fund source (for example eastmoney_snapshot).
FUND_SNAPSHOT_MIN_FUND_COUNT=1
FUND_SNAPSHOT_MIN_NAV_COVERAGE_RATIO=0
FUND_SNAPSHOT_MAX_LATEST_NAV_AGE_DAYS=0
FUND_SNAPSHOT_MAX_FUND_COUNT_DROP_RATIO=1
FUND_SNAPSHOT_QUALITY_OVERRIDES=
FUND_SYNC_SCHEDULER_ENABLED=true
FUND_SYNC_SCHEDULE_MODE=interval
FUND_SYNC_INTERVAL_MINUTES=5
FUND_SYNC_CRON=15 2 * * *
FUND_SYNC_JITTER_SECONDS=120
FUND_SYNC_MISFIRE_GRACE_SECONDS=900
FUND_SYNC_LOCK_TIMEOUT_MINUTES=120
YINGMI_MCP_ENDPOINT=
PUBLIC_FUND_DATA_BASE_URL=
PUBLIC_FUND_DATA_PROFILE=generic_aliases_v1
PUBLIC_FUND_DATA_TIMEOUT_SECONDS=10
PUBLIC_FUND_DATA_CACHE_DIR=
PUBLIC_FUND_DATA_MIN_INTERVAL_SECONDS=0
PUBLIC_FUND_DATA_BATCH_SIZE=100
PUBLIC_FUND_DATA_MAX_PAGES=100
# Optional comma-separated, operator-managed HTTP(S) proxies. Requests rotate
# round-robin; the app never discovers or fetches public proxy lists.
PUBLIC_FUND_DATA_PROXY_URLS=
