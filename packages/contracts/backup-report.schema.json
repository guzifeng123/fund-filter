{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fund-analysis.local/contracts/backup-report.schema.json",
  "title": "Database backup report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ok",
    "started_at",
    "finished_at",
    "duration_ms",
    "database",
    "service",
    "user",
    "compressed",
    "backup_path",
    "backup_file",
    "backup_size_bytes",
    "checksum_path",
    "retention_count",
    "removed_items",
    "skip_dump_for_retention_test"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "ok": { "type": "boolean" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "database": { "type": "string", "minLength": 1 },
    "service": { "type": "string", "minLength": 1 },
    "user": { "type": "string", "minLength": 1 },
    "compressed": { "type": "boolean" },
    "backup_path": { "type": "string", "minLength": 1 },
    "backup_file": { "type": "string", "minLength": 1 },
    "backup_size_bytes": { "type": "integer", "minimum": 1 },
    "checksum_path": { "type": "string", "minLength": 1 },
    "retention_count": { "type": "integer", "minimum": 0 },
    "removed_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skip_dump_for_retention_test": { "type": "boolean" }
  }
}
