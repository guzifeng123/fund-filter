{
  "openapi": "3.1.0",
  "paths": {
    "/items/{id}": {
      "get": {
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "ok" }, "422": { "description": "invalid" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    }
  }
}
